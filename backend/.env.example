PORT=4445
DATABASE_URL=postgresql://postgres_admin@127.0.0.1:55435/Scripto
CORS_ORIGINS=http://localhost:4444,http://127.0.0.1:4444
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
DEV_EMAIL_VERIFICATION_BYPASS=true
# "local-whisper" transcribes on-device (offline-capable) using a bundled whisper.cpp binary
# and GGML model; see backend/src/transcription/local-whisper.ts. Falls back to "mock" for
# local testing without the model installed, or "openai" for the placeholder cloud provider.
TRANSCRIPTION_PROVIDER=local-whisper
# Defaults to backend/vendor/whisper/{whisper-cli(.exe),ggml-base.en.bin} — override if the
# binary/model are installed elsewhere.
# WHISPER_BINARY_PATH=
# WHISPER_MODEL_PATH=
# FFMPEG_PATH=
