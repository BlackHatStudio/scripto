{
  "name": "scripto-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "seed": "node scripts/seed.mjs",
    "migrate": "node ../node_modules/prisma/build/index.js migrate dev",
    "prisma:generate": "node ../node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "pg": "^8.20.0",
    "sanitize-html": "^2.17.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sanitize-html": "^2.16.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
