{
  "name": "scripto",
  "version": "1.0.17",
  "private": true,
  "main": "desktop/main.mjs",
  "iohook": {
    "targets": [
      "node-137",
      "electron-139"
    ]
  },
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "node ./scripts/frontend-server.mjs",
    "dev:api": "node ./backend/scripts/dev.mjs",
    "desktop": "node ./scripts/desktop.mjs",
    "build": "node ./scripts/build.mjs",
    "start": "node ./scripts/frontend-server.mjs",
    "lint": "node ./node_modules/eslint/bin/eslint.js src --ext .ts,.tsx",
    "typecheck": "node ./scripts/typecheck.mjs",
    "seed": "node ./backend/scripts/seed.mjs",
    "fetch-whisper": "node ./backend/scripts/fetch-whisper.mjs",
    "migrate": "node ./node_modules/prisma/build/index.js migrate dev --schema backend/prisma/schema.prisma",
    "package": "node ./scripts/package-portable.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "@tkomde/iohook": "^1.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron": "^38.0.0",
    "lucide-react": "^0.545.0",
    "next": "^16.0.7",
    "pg": "^8.20.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  }
}
