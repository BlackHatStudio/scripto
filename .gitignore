# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# server
/backend/dist
/backend/node_modules
.npm-cache

# portable build output — generated by npm run package, not source
/dist-portable/
/dist-portable-work/

# vendored whisper.cpp binary + GGML model for offline dictation (~150MB) -
# fetched via `npm run fetch-whisper` (backend/scripts/fetch-whisper.mjs), not committed.
/backend/vendor/

# local runtime data & tool state (never commit)
/.local-pg/
/backend/.local-pg/
/.codex-appdata/
/.codex-localappdata/
/.playwright-mcp/
/.ccc-spawn-debug.json

# local logs & captured screenshots
*.log
/startup-debug.log
/backend/startup-debug.log
/localhost-*.png

# .NET build output (compiled binaries, not source)
[Bb]in/
[Oo]bj/
